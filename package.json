{
  "name": "phi-remote",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=4",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir /tmp/phi-remote-export",
    "icons": "node scripts/generate-icons.mjs",
    "test:mock-hub": "jest --config jest.integration.config.js",
    "notices": "node scripts/generate-notices.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@legendapp/list": "3.7.0",
    "@react-native-ai/apple": "0.12.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "marked": "^18.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "~26.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tools/",
      "<rootDir>/scripts/ios/",
      "<rootDir>/dist/",
      "\\.integration\\.test\\.ts$"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/tools/",
      "<rootDir>/dist/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|marked|zustand))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-audio"
      ]
    }
  }
}
